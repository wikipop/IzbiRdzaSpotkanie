# Configuration reference. `cargo xtask gen-keys` writes a ready-to-use .env
# with a fresh key pair; add any of the optional variables below to it.

# --- JWT (required for docker compose; the monolith generates keys if unset) ---
JWT_KEY_ID=k1
# Ed25519 private key, PKCS#8 PEM; newlines may be escaped as \n. Gateway only.
JWT_PRIVATE_KEY=
# Comma-separated kid=PEM list of public keys accepted by nano services.
JWT_PUBLIC_KEYS=

# --- Optional ---
# Comma-separated origins; `:*` allows any port.
ALLOWED_ORIGIN=http://localhost:*
TOKEN_TTL_DAYS=14
JWT_ISSUER=api-meet.izbi.beer
# json for one JSON object per line (default in the Docker images), anything else for pretty logs.
LOG_FORMAT=pretty
RUST_LOG=info

# --- Dokploy only ---
GATEWAY_IMAGE=ghcr.io/wikipop/meet-gateway:latest
NANO_IMAGE=ghcr.io/wikipop/meet-nano:latest
TRAEFIK_ENTRYPOINT=websecure
